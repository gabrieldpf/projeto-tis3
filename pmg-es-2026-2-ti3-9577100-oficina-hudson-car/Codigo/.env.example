# Copie para .env e ajuste os valores.
#
# Banco: PostgreSQL (Supabase). Pegue as duas URLs em:
#   Supabase > Project Settings > Database > Connection string
#
# DATABASE_URL = conexão "Transaction pooler" (porta 6543) usada pelo app.
#   Precisa do sufixo ?pgbouncer=true em ambiente serverless (Vercel).
DATABASE_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL = conexão direta (porta 5432) usada por `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
#
# Segredo para assinar o token de sessão (JWT). Gere um forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="gere-um-segredo-forte-aqui"
